<UserControl x:Class="AiInterviewAssistant.Settings.Appearance.AppearanceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel>

            <TextBlock
                Text="APPEARANCE"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="{DynamicResource MutedBrush}"
                Margin="2,0,0,16"/>

            <!-- ================================================= -->
            <!-- WINDOW OPACITY                                   -->
            <!-- ================================================= -->

            <TextBlock
                Text="Window Opacity"
                FontSize="13"
                Foreground="{DynamicResource TextBrush}"
                Margin="0,0,0,6"/>

            <Slider
                x:Name="OpacitySlider"
                Minimum="0.5"
                Maximum="1"
                Value="0.85"
                Margin="0,0,0,18"
                ValueChanged="OpacitySlider_ValueChanged"/>

        </StackPanel>

    </ScrollViewer>

</UserControl>