<Window x:Class="AiInterviewAssistant.Reports.InterviewReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interview Reports"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#151515"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- =========================================================
             TREE VIEW ITEM
             IMPORTANT:
             No IsSelected visual trigger.
             No selection background.
             ========================================================= -->

        <Style x:Key="ReportsTreeViewItemStyle"
               TargetType="{x:Type TreeViewItem}">

            <Setter Property="OverridesDefaultStyle"
                    Value="True"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="HorizontalAlignment"
                    Value="Left"/>

            <Setter Property="Cursor"
                    Value="Arrow"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type TreeViewItem}">

                        <StackPanel>

                            <!-- =================================================
                                 HEADER
                                 ================================================= -->

                            <Grid HorizontalAlignment="Left">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <!-- =================================================
                                     EXPANDER
                                     ================================================= -->

                                <ToggleButton x:Name="Expander"
                                              Grid.Column="0"
                                              Width="16"
                                              Height="16"
                                              Margin="0"
                                              Padding="0"
                                              Focusable="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Arrow"
                                              IsChecked="{Binding IsExpanded,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}">

                                    <ToggleButton.Template>

                                        <ControlTemplate
                                            TargetType="{x:Type ToggleButton}">

                                            <Grid>

                                                <TextBlock x:Name="Arrow"
                                                           Text="▶"
                                                           FontSize="9"
                                                           Foreground="#888888"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                            </Grid>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsChecked"
                                                         Value="True">

                                                    <Setter TargetName="Arrow"
                                                            Property="Text"
                                                            Value="▼"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                    </ToggleButton.Template>

                                </ToggleButton>


                                <!-- =================================================
                                     HEADER CONTENT

                                     No Border around entire header.
                                     Therefore line + icon + name are not
                                     given any native selection background.
                                     ================================================= -->

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>

                            </Grid>


                            <!-- =================================================
                                 CHILDREN
                                 ================================================= -->

                            <ItemsPresenter x:Name="ItemsHost"
                                            Margin="18,0,0,0"/>

                        </StackPanel>


                        <!-- =====================================================
                             TRIGGERS
                             ===================================================== -->

                        <ControlTemplate.Triggers>

                            <!-- No children -->

                            <Trigger Property="HasItems"
                                     Value="False">

                                <Setter TargetName="Expander"
                                        Property="Visibility"
                                        Value="Hidden"/>

                            </Trigger>


                            <!-- Collapsed -->

                            <Trigger Property="IsExpanded"
                                     Value="False">

                                <Setter TargetName="ItemsHost"
                                        Property="Visibility"
                                        Value="Collapsed"/>

                            </Trigger>


                            <!--
                                IMPORTANT:
                                NO IsSelected trigger.
                                Native selection background is intentionally
                                not shown.
                            -->

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =========================================================
             HEADER BUTTON STYLE
             ========================================================= -->

        <Style x:Key="HeaderButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="34"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Margin"
                    Value="2,0,0,0"/>

            <Setter Property="Foreground"
                    Value="#F0F0F0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Cursor"
                    Value="Arrow"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#292929"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#353535"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- =============================================================
         MAIN WINDOW
         ============================================================= -->

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- =========================================================
             HEADER
             ========================================================= -->

        <Border Grid.Row="0"
                Background="#1C1C1C"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Title -->

                <TextBlock Grid.Column="0"
                           Text="Interview Reports"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#F0F0F0"/>


                <!-- Header buttons -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">

                    <Button x:Name="RefreshButton"
                            Content="⟳"
                            Style="{StaticResource HeaderButtonStyle}"
                            Click="RefreshButton_Click"/>

                    <Button x:Name="CloseButton"
                            Content="✕"
                            Style="{StaticResource HeaderButtonStyle}"
                            Click="CloseButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- =========================================================
             MAIN CONTENT
             ========================================================= -->

        <Grid Grid.Row="1"
              Background="#151515">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="360"/>

                <ColumnDefinition Width="1"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- =====================================================
                 LEFT PANEL
                 ===================================================== -->

            <Grid Grid.Column="0"
                  Background="#181818">

                <Grid.RowDefinitions>

                    <RowDefinition Height="48"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- Section title -->

                <TextBlock Grid.Row="0"
                           Text="Interviews"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#F0F0F0"/>


                <!-- =================================================
                     REPORT TREE
                     ================================================= -->

                <TreeView x:Name="ReportsTreeView"
                          Grid.Row="1"
                          Margin="10,0,10,10"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="#F0F0F0"
                          ItemContainerStyle="{StaticResource ReportsTreeViewItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            </Grid>


            <!-- =====================================================
                 SEPARATOR
                 ===================================================== -->

            <Border Grid.Column="1"
                    Background="#303030"/>


            <!-- =====================================================
                 RIGHT PANEL
                 ===================================================== -->

            <Grid x:Name="ReportContentHost"
                  Grid.Column="2"
                  Background="#151515">


                <!-- =================================================
                     SELECTED REPORT TITLE
                     ================================================= -->

                <TextBlock x:Name="SelectedReportText"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="18,12,18,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#A0A0A0"/>


                <!-- =================================================
                     EMPTY STATE
                     ================================================= -->

                <Grid x:Name="EmptyStatePanel"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="📄"
                                   FontSize="42"
                                   HorizontalAlignment="Center"
                                   Foreground="#555555"/>

                        <TextBlock Text="Select an interview report"
                                   Margin="0,12,0,0"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   Foreground="#A0A0A0"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Window>