<Window x:Class="AiInterviewAssistant.AppMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430"
        SizeToContent="Height"
        MinHeight="190"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>

        <SolidColorBrush x:Key="TextBrush" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#858C99"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#252A32"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3A424E"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#4D8DFF"/>

        <Style x:Key="DialogButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="9">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="CancelButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DialogButtonStyle}">

            <Setter Property="Foreground" Value="#D5DAE2"/>
            <Setter Property="Background" Value="#303640"/>

        </Style>

    </Window.Resources>


    <Border
        Margin="8"
        CornerRadius="18"
        Background="#F20C0E12"
        BorderBrush="#39414D"
        BorderThickness="1">

        <Border.Effect>

            <DropShadowEffect
                BlurRadius="30"
                ShadowDepth="0"
                Opacity="0.5"/>

        </Border.Effect>


        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Border
                Grid.Row="0"
                Background="#22000000"
                CornerRadius="18,18,0,0"
                BorderBrush="#29313B"
                BorderThickness="0,0,0,1">

                <Grid Margin="18,0,12,0">

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <TextBlock
                            x:Name="IconTextBlock"
                            Text="●"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="{StaticResource BlueBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"/>

                        <TextBlock
                            x:Name="TitleTextBlock"
                            Text="Message"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- MESSAGE -->

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                MaxHeight="250">

                <TextBlock
                    x:Name="MessageTextBlock"
                    Margin="22,20,22,20"
                    FontSize="13"
                    LineHeight="20"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryBrush}"/>

            </ScrollViewer>


            <!-- BUTTONS -->

            <Border
                Grid.Row="2"
                Background="#16000000"
                CornerRadius="0,0,18,18"
                BorderBrush="#29313B"
                BorderThickness="0,1,0,0">

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="12,0,12,0">

                    <Button
                        x:Name="CancelButton"
                        Content="Cancel"
                        Style="{StaticResource CancelButtonStyle}"
                        Click="CancelButton_Click"
                        Visibility="Collapsed"/>

                    <Button
                        x:Name="NoButton"
                        Content="No"
                        Style="{StaticResource CancelButtonStyle}"
                        Click="NoButton_Click"
                        Visibility="Collapsed"/>

                    <Button
                        x:Name="YesButton"
                        Content="Yes"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="YesButton_Click"
                        Visibility="Collapsed"/>

                    <Button
                        x:Name="OkButton"
                        Content="OK"
                        Style="{StaticResource DialogButtonStyle}"
                        Click="OkButton_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</Window>