<Application x:Class="AiInterviewAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AiInterviewAssistant">

    <Application.Resources>

        <!-- =====================================================
             THEME BRUSHES
             ===================================================== -->

        <!-- Main window -->
        <SolidColorBrush x:Key="WindowBackgroundBrush"
                         Color="#660C0E12"/>

        <SolidColorBrush x:Key="WindowBorderBrush"
                         Color="#333C424D"/>

        <!-- Header / panels -->
        <SolidColorBrush x:Key="PanelBackgroundBrush"
                         Color="#22000000"/>

        <SolidColorBrush x:Key="PanelBorderBrush"
                         Color="#222F343D"/>

        <!-- Text -->
        <SolidColorBrush x:Key="TextBrush"
                         Color="#F4F6FA"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#858C99"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#8E95A3"/>

        <!-- Input -->
        <SolidColorBrush x:Key="InputBackgroundBrush"
                         Color="#33000000"/>

        <SolidColorBrush x:Key="InputBorderBrush"
                         Color="#303640"/>

        <!-- Settings controls -->
        <SolidColorBrush x:Key="SettingsBackgroundBrush"
                         Color="#252A32"/>

        <SolidColorBrush x:Key="SettingsBorderBrush"
                         Color="#3A424E"/>

        <!-- Accent -->
        <SolidColorBrush x:Key="AccentBrush"
                         Color="#4D8DFF"/>

        <SolidColorBrush x:Key="AccentHoverBrush"
                         Color="#659DFF"/>

        <!-- Status -->
        <SolidColorBrush x:Key="SuccessBrush"
                         Color="#4AD597"/>

        <SolidColorBrush x:Key="DangerBrush"
                         Color="#E85B5B"/>


        <!-- =====================================================
             COMMON BRUSH ALIASES
             ===================================================== -->

        <SolidColorBrush x:Key="WhiteBrush"
                         Color="#F4F6FA"/>

        <SolidColorBrush x:Key="BlueBrush"
                         Color="#4D8DFF"/>

        <SolidColorBrush x:Key="BlueHoverBrush"
                         Color="#659DFF"/>

        <SolidColorBrush x:Key="RedBrush"
                         Color="#E85B5B"/>


        <!-- =====================================================
             SETTINGS COMBOBOX
             ===================================================== -->

        <Style x:Key="SettingsComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="Background"
                    Value="{DynamicResource SettingsBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource SettingsBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="10,0"/>

        </Style>


        <!-- =====================================================
             SETTINGS TEXTBOX
             ===================================================== -->

        <Style x:Key="SettingsTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="Background"
                    Value="{DynamicResource SettingsBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource SettingsBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

    </Application.Resources>

</Application>